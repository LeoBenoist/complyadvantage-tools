{
  "name": "[P-TLO] [RL_0013] Payment Limit | Outbound",
  "description": "The customer's outbound transaction of {{Outbound_Transaction_Limit}} {{Base_Currency}} has exceeded the set limit.",
  "specification": {
    "value": {
      "segments": [],
      "parameters": {
        "risk_subject_groupings": ["TRANSACTION"]
      },
      "specification": {
        "and": [
          {
            "not_equals": [
              {
                "value": "transaction.monetary_details.base_value.iso_3_currency_code",
                "default": "CURRENCY_CODE",
                "datatype": "string",
                "type": "field"
              },
              {
                "value": "CURRENCY_CODE",
                "datatype": "string",
                "name": "Base_Currency",
                "type": "constant"
              }
            ]
          },
          {
            "equals": [
              {
                "value": "transaction.monetary_details.direction",
                "default": "NO_VALUE",
                "datatype": "string",
                "type": "field"
              },
              {
                "value": "MONETARY_TRANSACTION_DIRECTION_OUTBOUND",
                "datatype": "string",
                "name": null,
                "type": "constant"
              }
            ]
          },
          {
            "greater_than": [
              {
                "value": "transaction.monetary_details.base_value.amount",
                "default": "0",
                "datatype": "number",
                "type": "field"
              },
              {
                "value": "Outbound_Transaction_Limit",
                "name": "Outbound_Transaction_Limit",
                "format": "number",
                "type": "segment_parameter"
              }
            ]
          }
        ]
      }
    }
  }
}
