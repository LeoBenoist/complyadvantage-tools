                "default": "0",
                "datatype": "number",
                "type": "field"
              },
              {
                "value": "Loan_Repayment_Value_Limit",
                "name": "Loan_Repayment_Value_Limit",
                "format": "number",
                "type": "segment_parameter"
              }
            ]
          }
        ]
