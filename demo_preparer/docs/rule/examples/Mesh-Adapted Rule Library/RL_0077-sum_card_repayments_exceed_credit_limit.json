{
  "name": "[SUMRECRD] [RL_0077] Card Repayments Exceed Credit Limit",
  "description": "The customer's sum of inbound credit card repayments over the last 7 days was {{Credit_Limit}} {{Base_Currency}}, exceeding the set credit limit. [Credit-card repayments are matched as inbound bank payments on a credit-card loan product.]",
  "specification": {
    "value": {
      "segments": [],
      "parameters": {
        "risk_subject_groupings": ["CUSTOMER"]
      },
      "specification": {
        "and": [
          {
            "equals": [
              {
                "value": "transaction.monetary_details.direction",
                "default": "NO_VALUE",
                "datatype": "string",
                "type": "field"
              },
              {
                "value": "MONETARY_TRANSACTION_DIRECTION_INBOUND",
                "datatype": "string",
                "name": null,
                "type": "constant"
              }
            ]
          },
          {
            "not_equals": [
              {
                "type": "field",
                "value": "transaction.monetary_details.base_value.iso_3_currency_code",
                "datatype": "string",
                "default": "CURRENCY_CODE"
              },
              {
                "type": "constant",
                "name": "Base_Currency",
                "value": "CURRENCY_CODE",
                "datatype": "string"
              }
            ]
          },
          {
            "equals": [
              {
                "value": "transaction.type",
                "default": "NO_VALUE",
                "datatype": "string",
                "type": "field"
              },
              {
                "value": "TRANSACTION_TYPE_BANK_PAYMENT",
                "datatype": "string",
                "name": null,
                "type": "constant"
              }
            ]
          },
          {
            "equals": [
              {
                "value": "transaction.product.product_details.loan.loan_type",
                "default": "NO_VALUE",
                "datatype": "string",
                "type": "field"
              },
              {
                "value": "LOAN_TYPE_CREDIT_CARD",
                "datatype": "string",
                "name": null,
                "type": "constant"
              }
            ]
          },
          {
            "greater_than": [
              {
                "value": {
                  "aggregate": "sum",
                  "window": 7,
                  "window_unit": "calendar_day",
                  "target_field": "transaction.monetary_details.base_value.amount",
                  "include_current_record": true,
                  "exclude_current_day": false,
                  "show_context": true,
                  "filter_spec": {
                    "and": [
                      {
                        "equals": [
                          {
                            "value": "transaction.monetary_details.direction",
                            "default": "NO_VALUE",
                            "datatype": "string",
                            "type": "field"
                          },
                          {
                            "value": "MONETARY_TRANSACTION_DIRECTION_INBOUND",
                            "datatype": "string",
                            "name": null,
                            "type": "constant"
                          }
                        ]
                      },
                      {
                        "equals": [
                          {
                            "value": "transaction.type",
                            "default": "NO_VALUE",
                            "datatype": "string",
                            "type": "field"
                          },
                          {
                            "value": "TRANSACTION_TYPE_BANK_PAYMENT",
                            "datatype": "string",
                            "name": null,
                            "type": "constant"
                          }
                        ]
                      },
                      {
                        "equals": [
                          {
                            "value": "transaction.product.product_details.loan.loan_type",
                            "default": "NO_VALUE",
                            "datatype": "string",
                            "type": "field"
                          },
                          {
                            "value": "LOAN_TYPE_CREDIT_CARD",
                            "datatype": "string",
                            "name": null,
                            "type": "constant"
                          }
                        ]
                      }
                    ]
                  },
                  "grouping_fields": ["transaction.customer_identifier.id"],
                  "type": "scalar"
                },
                "type": "aggregation"
              },
              {
                "value": "Credit_Limit",
                "name": "Credit_Limit",
                "format": "number",
                "type": "segment_parameter"
              }
            ]
          }
        ]
      }
    }
  }
}
