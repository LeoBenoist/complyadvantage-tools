{
  "name": "[LOAN>INC] [RL_0071] High Cumulative Loan Repayments | Monthly Income",
  "description": "The customer's sum of loan repayments over the last 31 days was {{Monthly_Loan_Repayment_Sum_Limit}} {{Base_Currency}}, the most recent being a {{Loan_Type}} repayment, exceeding the set limit. [Set the limit to the customer's monthly-income-based ceiling; customer income is not available as a transaction field. Applicable to transactions on a loan product.]",
  "specification": {
    "value": {
      "segments": [],
      "parameters": {
        "risk_subject_groupings": ["CUSTOMER"]
      },
      "specification": {
        "and": [
          {
            "equals": [
              {
                "value": "transaction.monetary_details.direction",
                "default": "NO_VALUE",
                "datatype": "string",
                "type": "field"
              },
              {
                "value": "MONETARY_TRANSACTION_DIRECTION_INBOUND",
                "datatype": "string",
                "name": null,
                "type": "constant"
              }
            ]
          },
          {
            "not_equals": [
              {
                "value": "transaction.monetary_details.base_value.iso_3_currency_code",
                "default": "CURRENCY_CODE",
                "datatype": "string",
                "type": "field"
              },
              {
                "value": "CURRENCY_CODE",
                "datatype": "string",
                "name": "Base_Currency",
                "type": "constant"
              }
            ]
          },
          {
            "not_equals": [
              {
                "value": "transaction.product.product_details.loan.loan_type",
                "default": "LOAN_TYPE",
                "datatype": "string",
                "type": "field"
              },
              {
                "value": "LOAN_TYPE",
                "datatype": "string",
                "name": "Loan_Type",
                "type": "constant"
              }
            ]
          },
          {
            "greater_than": [
              {
                "value": {
                  "aggregate": "sum",
                  "window": 31,
                  "window_unit": "calendar_day",
                  "target_field": "transaction.monetary_details.base_value.amount",
                  "include_current_record": true,
                  "exclude_current_day": false,
                  "show_context": true,
                  "filter_spec": {
                    "and": [
                      {
                        "equals": [
                          {
                            "value": "transaction.monetary_details.direction",
                            "default": "NO_VALUE",
                            "datatype": "string",
                            "type": "field"
                          },
                          {
                            "value": "MONETARY_TRANSACTION_DIRECTION_INBOUND",
                            "datatype": "string",
                            "name": null,
                            "type": "constant"
                          }
                        ]
                      },
                      {
                        "not_equals": [
                          {
                            "value": "transaction.product.product_details.loan.loan_type",
                            "default": "LOAN_TYPE",
                            "datatype": "string",
                            "type": "field"
                          },
                          {
                            "value": "LOAN_TYPE",
                            "datatype": "string",
                            "name": "Loan_Type",
                            "type": "constant"
                          }
                        ]
                      }
                    ]
                  },
                  "grouping_fields": ["transaction.customer_identifier.id"],
                  "type": "scalar"
                },
                "type": "aggregation"
              },
              {
                "value": "Monthly_Loan_Repayment_Sum_Limit",
                "name": "Monthly_Loan_Repayment_Sum_Limit",
                "format": "number",
                "type": "segment_parameter"
              }
            ]
          }
        ]
      }
    }
  }
}
