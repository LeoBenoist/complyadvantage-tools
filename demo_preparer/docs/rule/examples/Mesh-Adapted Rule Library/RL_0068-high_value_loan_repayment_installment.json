                "default": "CURRENCY_CODE",
                "datatype": "string",
                "type": "field"
              },
              {
                "value": "CURRENCY_CODE",
                "datatype": "string",
                "name": "Base_Currency",
                "type": "constant"
              }
            ]
          },
          {
