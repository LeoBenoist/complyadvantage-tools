                "datatype": "string",
                "type": "field"
              },
              {
                "value": "MONETARY_TRANSACTION_DIRECTION_INBOUND",
                "datatype": "string",
                "name": null,
                "type": "constant"
              }
            ]
          },
          {
            "not_equals": [
              {
