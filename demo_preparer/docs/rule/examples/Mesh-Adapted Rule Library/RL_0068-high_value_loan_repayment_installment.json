{
  "name": "[LRGLOANP] [RL_0068] High Value Loan Repayment | Installment Amount",
  "description": "The customer's {{Loan_Type}} loan repayment of {{Min_Loan_Repayment_Delimiter}} {{Base_Currency}} exceeded the set multiple of the loan's {{Expected_Monthly_Installment_Amount}} {{Base_Currency}} expected monthly installment amount. [Applicable if the transaction is on a loan product and the expected monthly installment amount was provided.]",
  "specification": {
    "value": {
      "segments": [],
      "parameters": {
