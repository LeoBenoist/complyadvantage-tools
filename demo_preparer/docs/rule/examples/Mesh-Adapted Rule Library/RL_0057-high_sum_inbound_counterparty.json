{
  "name": "[SUMCCI] [RL_0057] High Sum | Inbound | Counterparty",
  "description": "The customer's {{Inbound_Sum_Limit}} {{Base_Currency}} sum of inbound transactions received from this counterparty over the last 14 days has exceeded the set limit.",
  "specification": {
    "value": {
      "segments": [],
      "parameters": {
        "risk_subject_groupings": ["CUSTOMER", "COUNTERPARTY"]
      },
      "specification": {
        "and": [
          {
            "not_equals": [
              {
                "type": "field",
                "value": "transaction.monetary_details.base_value.iso_3_currency_code",
                "datatype": "string",
                "default": "CURRENCY_CODE"
              },
              {
                "type": "constant",
                "name": "Base_Currency",
                "value": "CURRENCY_CODE",
                "datatype": "string"
              }
            ]
          },
          {
            "equals": [
              {
                "value": "transaction.monetary_details.direction",
                "default": "NO_VALUE",
                "datatype": "string",
                "type": "field"
              },
              {
                "value": "MONETARY_TRANSACTION_DIRECTION_INBOUND",
                "datatype": "string",
                "name": null,
                "type": "constant"
              }
            ]
          },
          {
            "greater_than": [
              {
                "value": {
                  "aggregate": "sum",
                  "window": 14,
                  "window_unit": "calendar_day",
                  "target_field": "transaction.monetary_details.base_value.amount",
                  "include_current_record": true,
                  "exclude_current_day": false,
                  "show_context": true,
                  "filter_spec": {
                    "equals": [
                      {
                        "value": "transaction.monetary_details.direction",
                        "default": "NO_VALUE",
                        "datatype": "string",
                        "type": "field"
                      },
                      {
                        "value": "MONETARY_TRANSACTION_DIRECTION_INBOUND",
                        "datatype": "string",
                        "name": null,
                        "type": "constant"
                      }
                    ]
                  },
                  "grouping_fields": [
                    {
                      "value": "counterparty-id",
                      "type": "block"
                    },
                    "transaction.customer_identifier.id"
                  ],
                  "type": "scalar"
                },
                "type": "aggregation"
              },
              {
                "value": "Inbound_Sum_Limit",
                "name": "Inbound_Sum_Limit",
                "format": "number",
                "type": "segment_parameter"
              }
            ]
          }
        ]
      }
    }
  }
}
