{
  "name": "[IN-OUT-2] [RL_0025] Large Outbound Transaction Following High Velocity Inbound Transactions",
  "description": "The customer's outbound transaction of {{Outbound_Limit}} {{Base_Currency}} exceeded the set limit, and the customer had {{Min_Number_of_Inbound_Transaction}} inbound transactions within the last 14 days, which represents a high previous inbound velocity.",
  "specification": {
    "value": {
      "segments": [],
      "parameters": {
        "risk_subject_groupings": ["TRANSACTION"]
      },
      "specification": {
        "and": [
          {
            "not_equals": [
              {
                "value": "transaction.monetary_details.base_value.iso_3_currency_code",
                "default": "CURRENCY_CODE",
                "datatype": "string",
                "type": "field"
              },
              {
                "value": "CURRENCY_CODE",
                "datatype": "string",
                "name": "Base_Currency",
                "type": "constant"
              }
            ]
          },
          {
            "equals": [
              {
                "value": "transaction.monetary_details.direction",
                "default": "NO_VALUE",
                "datatype": "string",
                "type": "field"
              },
              {
                "value": "MONETARY_TRANSACTION_DIRECTION_OUTBOUND",
                "datatype": "string",
                "name": null,
                "type": "constant"
              }
            ]
          },
          {
            "greater_than": [
              {
                "value": "transaction.monetary_details.base_value.amount",
                "default": "0",
                "datatype": "number",
                "type": "field"
              },
              {
                "value": "Outbound_Limit",
                "name": "Outbound_Limit",
                "format": "number",
                "type": "segment_parameter"
              }
            ]
          },
          {
            "greater_than_or_equals": [
              {
                "value": {
                  "aggregate": "count",
                  "window": 14,
                  "window_unit": "calendar_day",
                  "target_field": null,
                  "include_current_record": true,
                  "exclude_current_day": false,
                  "show_context": true,
                  "filter_spec": {
                    "equals": [
                      {
                        "value": "transaction.monetary_details.direction",
                        "default": "NO_VALUE",
                        "datatype": "string",
                        "type": "field"
                      },
                      {
                        "value": "MONETARY_TRANSACTION_DIRECTION_INBOUND",
                        "datatype": "string",
                        "name": null,
                        "type": "constant"
                      }
                    ]
                  },
                  "grouping_fields": ["transaction.customer_identifier.id"],
                  "type": "scalar"
                },
                "type": "aggregation"
              },
              {
                "value": "Min_Number_of_Inbound_Transaction",
                "name": "Min_Number_of_Inbound_Transaction",
                "format": "number",
                "type": "segment_parameter"
              }
