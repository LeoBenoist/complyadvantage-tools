{
  "name": "[SUMCARD] [RL_0109] High Sum | Card Authorizations [Stage Updated In Place]",
  "description": "The customer's {{Authorization_Sum_Limit}} {{Base_Currency}} sum of card authorizations over the last 7 days has exceeded the set authorization sum limit.",
  "specification": {
    "value": {
      "segments": [],
      "parameters": {
        "risk_subject_groupings": ["CUSTOMER"]
      },
      "specification": {
        "and": [
          {
            "not_equals": [
              {
                "type": "field",
                "value": "transaction.monetary_details.base_value.iso_3_currency_code",
                "datatype": "string",
                "default": "CURRENCY_CODE"
              },
              {
                "type": "constant",
                "name": "Base_Currency",
                "value": "CURRENCY_CODE",
                "datatype": "string"
              }
            ]
          },
          {
            "equals": [
              {
                "value": "transaction.type",
                "default": "NO_VALUE",
                "datatype": "string",
                "type": "field"
              },
              {
                "value": "TRANSACTION_TYPE_CARD_PAYMENT",
                "datatype": "string",
                "name": null,
                "type": "constant"
              }
            ]
          },
          {
            "equals": [
              {
                "value": "transaction.monetary_details.card_payment.payment_stage",
                "default": "NO_VALUE",
                "datatype": "string",
                "type": "field"
              },
              {
                "value": "CARD_PAYMENT_STAGE_AUTHORIZED",
                "datatype": "string",
                "name": null,
                "type": "constant"
              }
            ]
          },
          {
            "greater_than": [
              {
                "value": {
                  "aggregate": "sum",
                  "window": 7,
                  "window_unit": "calendar_day",
                  "target_field": "transaction.monetary_details.base_value.amount",
                  "include_current_record": true,
                  "exclude_current_day": false,
                  "filter_spec": {
                    "and": [
                      {
                        "equals": [
                          {
                            "value": "transaction.type",
                            "default": "NO_VALUE",
                            "datatype": "string",
                            "type": "field"
                          },
                          {
                            "value": "TRANSACTION_TYPE_CARD_PAYMENT",
                            "datatype": "string",
                            "name": null,
                            "type": "constant"
                          }
                        ]
                      },
                      {
                        "any_of": [
                          {
                            "value": "transaction.monetary_details.card_payment.payment_stages_info.authorization.state",
                            "default": "NO_VALUE",
                            "datatype": "string",
                            "type": "field"
                          },
                          {
                            "name": "Committable_Authorization_States",
                            "values": ["AUTHORIZATION_STATE_APPROVED", "AUTHORIZATION_STATE_PENDING"],
                            "datatype": "string",
                            "type": "constant_list"
                          }
                        ]
                      }
                    ]
                  },
                  "grouping_fields": ["transaction.customer_identifier.id"],
                  "type": "scalar"
                },
                "type": "aggregation"
              },
              {
                "value": "Authorization_Sum_Limit",
                "name": "Authorization_Sum_Limit",
                "format": "number",
                "type": "segment_parameter"
              }
            ]
          }
        ]
      }
    }
  }
}
