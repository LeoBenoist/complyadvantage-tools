{
  "name": "[NUMLOAN] [RL_0069] High Velocity Loan Repayments | 90 Days",
  "description": "The customer made {{Loan_Repayment_Velocity_Limit}} loan repayments within the last 90 days, the most recent being a {{Loan_Type}} repayment, exceeding the set loan repayment velocity limit. [Applicable to transactions on a loan product.]",
  "specification": {
    "value": {
      "segments": [],
      "parameters": {
        "risk_subject_groupings": ["CUSTOMER"]
      },
      "specification": {
        "and": [
          {
            "equals": [
              {
                "value": "transaction.monetary_details.direction",
                "default": "NO_VALUE",
                "datatype": "string",
                "type": "field"
              },
              {
                "value": "MONETARY_TRANSACTION_DIRECTION_INBOUND",
                "datatype": "string",
                "name": null,
                "type": "constant"
              }
            ]
          },
          {
            "not_equals": [
              {
                "value": "transaction.product.product_details.loan.loan_type",
                "default": "LOAN_TYPE",
                "datatype": "string",
                "type": "field"
              },
              {
                "value": "LOAN_TYPE",
                "datatype": "string",
                "name": "Loan_Type",
                "type": "constant"
              }
            ]
          },
          {
            "greater_than": [
              {
                "value": {
                  "aggregate": "count",
                  "window": 90,
                  "window_unit": "calendar_day",
                  "target_field": null,
                  "include_current_record": true,
                  "exclude_current_day": false,
                  "show_context": true,
                  "filter_spec": {
                    "and": [
                      {
                        "equals": [
                          {
                            "value": "transaction.monetary_details.direction",
                            "default": "NO_VALUE",
                            "datatype": "string",
                            "type": "field"
                          },
                          {
                            "value": "MONETARY_TRANSACTION_DIRECTION_INBOUND",
                            "datatype": "string",
                            "name": null,
                            "type": "constant"
                          }
                        ]
                      },
                      {
                        "not_equals": [
                          {
                            "value": "transaction.product.product_details.loan.loan_type",
                            "default": "LOAN_TYPE",
                            "datatype": "string",
                            "type": "field"
                          },
                          {
                            "value": "LOAN_TYPE",
                            "datatype": "string",
                            "name": "Loan_Type",
                            "type": "constant"
                          }
                        ]
                      }
                    ]
                  },
                  "grouping_fields": ["transaction.customer_identifier.id"],
                  "type": "scalar"
                },
                "type": "aggregation"
              },
              {
                "value": "Loan_Repayment_Velocity_Limit",
                "name": "Loan_Repayment_Velocity_Limit",
                "format": "number",
                "type": "segment_parameter"
              }
            ]
          }
        ]
      }
    }
  }
}
