{
  "name": "High Sum - Inbound - 7 Days",
  "description": "The customer has reached or surpassed their 7-day inbound transaction limit of {{Limit}}.",
  "specification": {
    "value": {
      "segments": [],
      "parameters": {
        "risk_subject_groupings": ["CUSTOMER"]
      },
      "specification": {
        "and": [
          {
            "equals": [
              {
                "value": "transaction.monetary_details.direction",
                "default": "NO_VALUE",
                "datatype": "string",
                "type": "field"
              },
              {
                "value": "MONETARY_TRANSACTION_DIRECTION_INBOUND",
                "datatype": "string",
                "name": null,
                "type": "constant"
              }
            ]
          },
          {
            "greater_than": [
              {
                "value": {
                  "uuid": null,
                  "aggregate": "sum",
                  "window": 7,
                  "show_context": true,
                  "window_unit": "calendar_day",
                  "target_field": "transaction.monetary_details.base_value.amount",
                  "include_current_record": true,
                  "exclude_current_day": false,
                  "filter_spec": null,
                  "grouping_fields": [
                    "transaction.customer_identifier.id",
                    "transaction.monetary_details.direction"
                  ],
                  "type": "scalar"
                },
                "type": "aggregation"
              },
              {
                "value": "11111111-1111-1111-1111-111111111111",
                "name": "Limit",
                "format": "number",
                "type": "segment_parameter"
              }
            ]
          }
        ]
      }
    }
  }
}
