{
  "name": "High Cumulative Amount - Outbound",
  "description": "Outgoing transaction sum of {{Amount}} over the last 7 days has exceeded the limit.",
  "specification": {
    "value": {
      "segments": [],
      "parameters": {
        "risk_subject_groupings": ["CUSTOMER"]
      },
      "specification": {
        "and": [
          {
            "equals": [
              {
                "value": "transaction.monetary_details.direction",
                "default": "MONETARY_TRANSACTION_DIRECTION_OUTBOUND",
                "datatype": "string",
                "type": "field"
              },
              {
                "value": "MONETARY_TRANSACTION_DIRECTION_OUTBOUND",
                "datatype": "string",
                "name": null,
                "type": "constant"
              }
            ]
          },
          {
            "greater_than": [
              {
                "value": {
                  "uuid": null,
                  "aggregate": "sum",
                  "window": 7,
                  "show_context": true,
                  "window_unit": "day",
                  "target_field": "transaction.monetary_details.base_value.amount",
                  "include_current_record": true,
                  "exclude_current_day": false,
                  "filter_spec": {
                    "equals": [
                      {
                        "value": "transaction.monetary_details.direction",
                        "default": "MONETARY_TRANSACTION_DIRECTION_OUTBOUND",
                        "datatype": "string",
                        "type": "field"
                      },
                      {
                        "value": "MONETARY_TRANSACTION_DIRECTION_OUTBOUND",
                        "datatype": "string",
                        "name": null,
                        "type": "constant"
                      }
                    ]
                  },
                  "grouping_fields": [
                    "transaction.customer_identifier.id",
                    "transaction.monetary_details.direction"
                  ],
                  "type": "scalar"
                },
                "type": "aggregation"
              },
              {
                "value": "11111111-1111-1111-1111-111111111111",
                "name": "Amount",
                "format": "number",
                "type": "segment_parameter"
              }
            ]
          }
        ]
      }
    }
  }
}
